VITE_ROOT_URL = "https://localhost:8152/"

# VITE_ROOT_URL = "https://www.isd-sis.mil/"

# HR Cycles API base URL. All hrcycles_api/* calls use this host when set.
# VITE_HRCYCLES_URL = "https://localhost:7178/"
# VITE_HRCYCLES_URL = "https://www.isd-sis.mil/"

# Published/production base URL. All sec_api/* calls use this host when set,
# even while VITE_ROOT_URL points at localhost.
#VITE_PUBLISH_URL = "https://www.isd-sis.mil/"
VITE_PUBLISH_URL = "https://localhost:7177/"

# OnlyOffice Document Server public origin (loads /web-apps/apps/api/documents/api.js)
VITE_ONLYOFFICE_PUBLIC_URL = "https://www.isd-sis.mil/onlyoffice"
VITE_BASE_PATH = "./"

# Keycloak Configuration
VITE_KEYCLOAK_URL = "https://www.isd-sis.mil/authentication"
VITE_KEYCLOAK_REALM = "master"
VITE_KEYCLOAK_CLIENT_ID = "sis"

# Token Check Configuration

VITE_ENABLE_TOKEN_CHECK = "true"
